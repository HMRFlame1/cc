<script>
var ccInited = false;
function init() {
  if (ccInited) return;
  if (!document.getElementById("cc")) return;
  ccInited = true;
  var heroN = document.getElementById("heroCombo");
  if (heroN) {
    var t = 128, s = performance.now();
    function tick(n) {
      var p = Math.min(1, (n - s) / 1600);
      heroN.textContent = Math.round(t * (1 - Math.pow(1 - p, 3))) + "x";
      if (p < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }
  var canvas = document.getElementById("embers");
  if (canvas && canvas.getContext) {
    var ctx = canvas.getContext("2d"), w, h, bits;
    function resize() {
      w = canvas.width = canvas.offsetWidth || canvas.parentElement.offsetWidth;
      h = canvas.height = canvas.offsetHeight || canvas.parentElement.offsetHeight;
      bits = [];
      for (var i = 0; i < 42; i++) {
        bits.push({ x: Math.random() * w, y: Math.random() * h, r: Math.random() * 2 + 0.5, s: Math.random() * 0.7 + 0.25, a: Math.random() * 0.5 + 0.2, c: Math.random() > 0.35 ? "255,90,20" : "80,200,255" });
      }
    }
    resize();
    window.addEventListener("resize", resize);
    (function draw() {
      ctx.clearRect(0, 0, w, h);
      for (var i = 0; i < bits.length; i++) {
        var p = bits[i];
        p.y -= p.s; p.x += Math.sin(p.y * 0.02) * 0.3;
        if (p.y < -8) { p.y = h + 8; p.x = Math.random() * w; }
        ctx.beginPath(); ctx.fillStyle = "rgba(" + p.c + "," + p.a + ")"; ctx.arc(p.x, p.y, p.r, 0, 6.28); ctx.fill();
      }
      requestAnimationFrame(draw);
    })();
  }
}
window.onload = init;
if (document.readyState === "complete" || document.readyState === "interactive") { init(); }
</script>
